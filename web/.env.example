# ==============================================================================
# The Go-getters (Geters) Platform — Environment Configuration Template
# Copy this file to .env and provide your actual secrets. Do NOT commit .env!
# ==============================================================================

# Node Environment ("development" | "production" | "test")
NODE_ENV=development

# Application Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Panel Activation (set "true" to expose /dashboard/admin and /api/admin)
ENABLE_ADMIN_PANEL=false
NEXT_PUBLIC_ENABLE_ADMIN=false
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=false
ADMIN_EMAILS=admin@example.com

# PostgreSQL / Neon Database Connection String
# e.g. postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/gogetters?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gogetters_db
DB_REJECT_UNAUTHORIZED=true

# JWT Signing Secret (Minimum 32 characters, required in production)
JWT_SECRET=your_jwt_secret_min_32_characters_random_string_here

# Google OAuth 2.0 Client Credentials
GOOGLE_AUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Google Gemini AI Bot Engine
GOOGLE_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
OPEN_ROUTER_API_KEY=sk-or-your-optional-open-router-key

# Bunny.net Storage & CDN (For Avatars, Post Images & General File Uploads)
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
BUNNY_CDN_URL=https://your-pull-zone.b-cdn.net

# Bunny.net Video Stream (For Transcoded Video Hosting & HLS Delivery)
BUNNY_VIDEO_LIBRARY_ID=123456
BUNNY_VIDEO_API_KEY=your-bunny-video-stream-api-key
BUNNY_CDN_HOSTNAME=vz-sample.b-cdn.net
BUNNY_READ_ONLY_API_KEY=your-bunny-read-only-key

# OneSignal Push Notifications (Web & Mobile Push)
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=web.onesignal.auto.your-safari-web-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Telegram Notifications & Retention Engine
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_NOTIFICATION_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_CHAT_ID=123456789

# IndexNow API Key (Yandex & Bing instant indexing for newly published articles/videos/news)
INDEXNOW_KEY=geters2026indexnowkey8f4a9c2d1e7b



# Local development only: explicitly allow admin panel access without ADMIN_EMAILS
ALLOW_DEV_ADMIN=false
